<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/nlog-internal.log">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <!-- Information לשימוש רגיל. בסביבת פיתוח Program.cs מוריד ל-Debug -->
  <variable name="minLevel" value="Info" />
  <variable name="logDirectory" value="${basedir}/logs" />

  <!-- פורמט שורה: זמן | רמה | מי כתב | CorrelationId | ההודעה והחריגה (אם יש).
       בכוונה אין כאן גוף בקשה, כותרות או סיסמאות: לוג הוא קובץ שאנשים קוראים -->
  <variable name="lineLayout"
            value="${longdate}|${level:uppercase=true:padding=-5}|${logger:shortName=true}|${scopeproperty:CorrelationId}|${message}${onexception:inner=${newline}${exception:format=tostring}}" />

  <targets>
    <target xsi:type="Console" name="console" layout="${lineLayout}" />

    <!-- קובץ חדש לכל יום, ושמירת 14 הימים האחרונים -->
    <target xsi:type="File"
            name="file"
            fileName="${logDirectory}/parking-${shortdate}.log"
            layout="${lineLayout}"
            encoding="utf-8"
            maxArchiveFiles="14" />
  </targets>

  <rules>
    <!-- הרעש של .NET עצמו (ב-Information ומטה) לא נכתב; אזהרות ושגיאות שלו כן -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <logger name="*" minlevel="${var:minLevel}" writeTo="console,file" />
  </rules>
</nlog>
